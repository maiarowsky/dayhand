{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.helm.invalid/task.schema.json",
  "title": "Task",
  "description": "A task as every tool returns it. Fields may be added; none are removed or retyped within a major version.",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "isNow",
    "labels",
    "links",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable task id"
    },
    "ref": {
      "type": "integer",
      "minimum": 1,
      "description": "The user's task number (#42); missing only on tasks from before 0.3.0 that were not migrated"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "enum": [
        "todo",
        "doing",
        "done"
      ]
    },
    "isNow": {
      "type": "boolean"
    },
    "note": {
      "type": "string"
    },
    "dueDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Due day in the user's time zone"
    },
    "dueTime": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}$",
      "description": "Due time HH:MM, 24h, local"
    },
    "resumeNote": {
      "type": "string"
    },
    "repeat": {
      "type": "object",
      "required": [
        "every",
        "interval"
      ],
      "properties": {
        "every": {
          "enum": [
            "day",
            "week",
            "month",
            "year"
          ]
        },
        "interval": {
          "type": "number"
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          }
        }
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "completedAt": {
      "type": "number",
      "description": "Unix time in milliseconds"
    },
    "archivedAt": {
      "type": "number",
      "description": "Unix time in milliseconds"
    },
    "deletedAt": {
      "type": "number",
      "description": "Unix time in milliseconds"
    },
    "createdAt": {
      "type": "number",
      "description": "Unix time in milliseconds"
    },
    "updatedAt": {
      "type": "number",
      "description": "Unix time in milliseconds"
    },
    "clientId": {
      "type": "string",
      "description": "clientId of the operation that created the task"
    },
    "overdue": {
      "type": "boolean",
      "description": "Only in list_all, board and get_task"
    }
  }
}
