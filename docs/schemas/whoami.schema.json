{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.helm.invalid/whoami.schema.json",
  "title": "Who am I",
  "description": "hlm whoami: the connection hlm uses, checked against the server. Never contains the key.",
  "type": "object",
  "required": [
    "url",
    "urlSource",
    "profile",
    "keySource",
    "configFile",
    "configFound",
    "server",
    "timezone"
  ],
  "properties": {
    "url": {
      "type": "string"
    },
    "urlSource": {
      "type": "string",
      "description": "--url, --profile <name>, HLM_URL, HELM_URL, profile <name>, config.toml"
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "keySource": {
      "type": "string",
      "description": "HLM_API_KEY, HELM_API_KEY, keychain or file"
    },
    "configFile": {
      "type": "string"
    },
    "configFound": {
      "type": "boolean"
    },
    "server": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "timezone": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
