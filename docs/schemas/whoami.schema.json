{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dayhand.invalid/whoami.schema.json",
  "title": "Who am I",
  "description": "dayhand whoami: the connection dayhand uses, checked against the server. Never contains the key.",
  "type": "object",
  "required": [
    "url",
    "urlSource",
    "profile",
    "keySource",
    "configFile",
    "configFound",
    "server",
    "timezone"
  ],
  "properties": {
    "url": {
      "type": "string"
    },
    "urlSource": {
      "type": "string",
      "description": "--url, --profile <name>, DAYHAND_URL (or its old name HLM_URL or HELM_URL), profile <name>, config.toml"
    },
    "profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "keySource": {
      "type": "string",
      "description": "DAYHAND_API_KEY (or its old name HLM_API_KEY or HELM_API_KEY), keychain or file"
    },
    "configFile": {
      "type": "string"
    },
    "configFound": {
      "type": "boolean"
    },
    "server": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "timezone": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
