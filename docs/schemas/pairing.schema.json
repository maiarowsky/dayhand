{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dayhand.invalid/pairing.schema.json",
  "title": "Pairing code",
  "description": "POST /devices/pairing-code plus the deep link (dayhand pair).",
  "type": "object",
  "required": [
    "code",
    "expiresAt",
    "expiresIn",
    "link"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[0-9A-Z]{4}-[0-9A-Z]{4}-[0-9A-Z]{4}$"
    },
    "expiresAt": {
      "type": "number",
      "description": "Unix time in milliseconds"
    },
    "expiresIn": {
      "type": "number",
      "description": "Seconds"
    },
    "link": {
      "type": "string",
      "pattern": "^dayhand://pair\\?"
    }
  }
}
