{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dayhand.invalid/export.schema.json",
  "title": "Export",
  "description": "export_plan (dayhand export --json): {format: markdown, content: <text>}, {format: json, content: <copy>} or {format: ics, content: <iCalendar text>}. With -o, dayhand prints {written: <file>, format}.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "format",
        "content"
      ],
      "properties": {
        "format": {
          "const": "markdown"
        },
        "content": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "format",
        "content"
      ],
      "properties": {
        "format": {
          "const": "json"
        },
        "content": {
          "type": "object",
          "required": [
            "version",
            "exportedAt",
            "settings",
            "tasks",
            "events"
          ],
          "properties": {
            "version": {
              "type": "integer"
            },
            "exportedAt": {
              "type": "number",
              "description": "Unix time in milliseconds"
            },
            "settings": {
              "$ref": "settings.schema.json"
            },
            "projects": {
              "type": "array",
              "description": "Every project in menu order, archived and empty ones included; tasks name theirs by projectId (since 0.13.0)",
              "items": {
                "$ref": "project.schema.json"
              }
            },
            "tasks": {
              "type": "array",
              "items": {
                "$ref": "task.schema.json"
              }
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "format",
        "content"
      ],
      "properties": {
        "format": {
          "const": "ics"
        },
        "content": {
          "type": "string",
          "description": "RFC 5545 iCalendar text with CRLF line ends"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "written",
        "format"
      ],
      "properties": {
        "written": {
          "type": "string"
        },
        "format": {
          "enum": [
            "markdown",
            "json",
            "ics"
          ]
        }
      }
    }
  ]
}
