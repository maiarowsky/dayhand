{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.helm.invalid/today.schema.json",
  "title": "Today",
  "description": "list_today (hlm, hlm today, hlm now without a task).",
  "type": "object",
  "required": [
    "date",
    "timezone",
    "now",
    "overdue",
    "today",
    "doneToday"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "type": "string"
    },
    "now": {
      "anyOf": [
        {
          "$ref": "task.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "overdue": {
      "type": "array",
      "items": {
        "$ref": "task.schema.json"
      }
    },
    "today": {
      "type": "array",
      "items": {
        "$ref": "task.schema.json"
      }
    },
    "doneToday": {
      "type": "array",
      "items": {
        "$ref": "task.schema.json"
      }
    }
  }
}
