{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dayhand.invalid/results.schema.json",
  "title": "Several task or project results",
  "description": "A command given several tasks or projects: one tool result per reference, in order.",
  "type": "object",
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 2,
      "items": {
        "anyOf": [
          {
            "$ref": "task.schema.json"
          },
          {
            "$ref": "complete.schema.json"
          },
          {
            "$ref": "project.schema.json"
          }
        ]
      }
    }
  }
}
