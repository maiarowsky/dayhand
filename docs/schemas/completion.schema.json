{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dayhand.invalid/completion.schema.json",
  "title": "Completion",
  "description": "dayhand completion: the script for a shell.",
  "type": "object",
  "required": [
    "shell",
    "script"
  ],
  "properties": {
    "shell": {
      "type": "string",
      "enum": [
        "bash",
        "zsh",
        "fish",
        "powershell"
      ]
    },
    "script": {
      "type": "string"
    }
  }
}
