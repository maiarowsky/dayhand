{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dayhand.invalid/logout.schema.json",
  "title": "Logout",
  "description": "dayhand logout: the stores the key was removed from (empty when none had one).",
  "type": "object",
  "required": [
    "url",
    "removed"
  ],
  "properties": {
    "url": {
      "type": "string"
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "keychain",
          "file"
        ]
      }
    }
  }
}
