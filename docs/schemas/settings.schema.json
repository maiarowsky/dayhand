{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dayhand.invalid/settings.schema.json",
  "title": "Settings",
  "description": "get_settings and update_settings (dayhand settings, dayhand settings set).",
  "type": "object",
  "required": [
    "timezone",
    "summaryTime",
    "defaultReminderMinutes"
  ],
  "properties": {
    "timezone": {
      "type": "string"
    },
    "summaryTime": {
      "type": "string",
      "pattern": "^\\d{2}:\\d{2}$"
    },
    "defaultReminderMinutes": {
      "type": "array",
      "items": {
        "type": "number"
      }
    }
  }
}
