          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayhand 无法连接更新服务器。请检查网络连接后重试。"
          }
        }
      }
    },
    "Dayhand could not restart. Quit it and open it again." : {
      "comment" : "Alert",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayhand konnte nicht neu starten. Beende es und öffne es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayhand could not restart. Quit it and open it again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayhand no pudo reiniciarse. Ciérralo y vuelve a abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
