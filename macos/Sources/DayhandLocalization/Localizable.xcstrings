          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayhand を再起動できませんでした。終了してからもう一度開いてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
