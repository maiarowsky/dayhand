        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayhand 无法重新启动。请退出后重新打开。"
          }
        }
      }
    },
    "Dayhand forgets the sign-in on this Mac; your tasks stay here. To end it on the server too, run: dayhand revoke %@" : {
      "comment" : "Confirmation message; the argument is the device id",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayhand vergisst die Anmeldung auf diesem Mac; deine Aufgaben bleiben hier. Um sie auch auf dem Server zu beenden, führe aus: dayhand revoke %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayhand forgets the sign-in on this Mac; your tasks stay here. To end it on the server too, run: dayhand revoke %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayhand olvida el inicio de sesión en este Mac; tus tareas se quedan aquí. Para cerrarlo también en el servidor, ejecuta: dayhand revoke %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayhand oublie la connexion sur ce Mac ; vos tâches restent ici. Pour y mettre fin aussi sur le serveur, lancez : dayhand revoke %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayhand はこの Mac のサインイン情報を削除します。タスクはここに残ります。サーバー側でも終了するには次を実行してください：dayhand revoke %@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayhand zapomni logowanie na tym Macu; zadania zostaną tutaj. Aby zakończyć je także na serwerze, uruchom: dayhand revoke %@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dayhand esquece o login neste Mac; suas tarefas ficam aqui. Para encerrá-lo também no servidor, execute: dayhand revoke %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dayhand 会忘记这台 Mac 上的登录信息；你的任务仍保留在这里。要在服务器上也结束登录，请运行：dayhand revoke %@"
          }
        }
      }
    },
