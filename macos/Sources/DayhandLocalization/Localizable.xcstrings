    "Type a title and, at its end, a day or time in English: “Call the accountant fri 2pm”, “Pay rent the 1st”, “Plan next week”." : {
      "comment" : "Settings hint; the examples are English phrases",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einen Titel ein und am Ende einen Tag oder eine Uhrzeit auf Englisch: „Call the accountant fri 2pm“, „Pay rent the 1st“, „Plan next week“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type a title and, at its end, a day or time in English: “Call the accountant fri 2pm”, “Pay rent the 1st”, “Plan next week”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe un título y, al final, un día u hora en inglés: «Call the accountant fri 2pm», «Pay rent the 1st», «Plan next week»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez un titre puis, à la fin, un jour ou une heure en anglais : « Call the accountant fri 2pm », « Pay rent the 1st », « Plan next week »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトルの最後に英語で日付や時刻を書きます：「Call the accountant fri 2pm」「Pay rent the 1st」「Plan next week」。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wpisz tytuł, a na jego końcu dzień lub godzinę po angielsku: „Call the accountant fri 2pm”, „Pay rent the 1st”, „Plan next week”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite um título e, no final, um dia ou horário em inglês: “Call the accountant fri 2pm”, “Pay rent the 1st”, “Plan next week”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
