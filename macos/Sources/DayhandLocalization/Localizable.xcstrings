    "“%@” is archived; restore it first." : {
      "comment" : "Error when a task is moved to an archived project; the argument is the project's name",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist archiviert; stelle es zuerst wieder her."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is archived; restore it first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» está archivado; restáuralo primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » est archivé ; restaurez-le d’abord."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はアーカイブされています。先に元に戻してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
