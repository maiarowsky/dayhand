      }
    },
    "“none” is reserved: it means tasks without a project." : {
      "comment" : "Error when a project is to be named none, the word filters use for tasks without a project; keep none in English",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„none“ ist reserviert: Es steht für Aufgaben ohne Projekt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“none” is reserved: it means tasks without a project."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«none» está reservado: significa tareas sin proyecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« none » est réservé : il désigne les tâches sans projet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「none」は予約語です。プロジェクトのないタスクを表します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„none” jest zarezerwowane: oznacza zadania bez projektu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“none” é reservado: significa tarefas sem projeto."
