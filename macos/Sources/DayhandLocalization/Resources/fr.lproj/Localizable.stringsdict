		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld jour avant</string>
			<key>other</key>
			<string>%lld jours avant</string>
		</dict>
	</dict>
