	<key>The trash is empty. Deleted tasks stay here for %lld days.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@value@</string>
		<key>value</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>ゴミ箱は空です。削除したタスクはここに%lld日間残ります。</string>
		</dict>
