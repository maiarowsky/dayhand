---
// The end of every page: the licence in one line, the links people look for last, and what this site does not do.
import { DOCS_PATH, REPO_URL, repoFile } from "../site";

const links = [
  { href: DOCS_PATH, label: "Documentation" },
  { href: REPO_URL, label: "Source code" },
  { href: repoFile("cli/CHANGELOG.md"), label: "Changelog" },
  { href: repoFile("CONTRIBUTING.md"), label: "Contributing" },
  { href: repoFile("SECURITY.md"), label: "Security" },
  { href: repoFile("LICENSE"), label: "Apache License 2.0" },
];
---

<footer class="site-footer">
  <p class="brand-line">
    <img src="/favicon.svg" alt="" width="24" height="24" />
    Dayhand is free and open source under the Apache License 2.0.
  </p>
  <nav aria-label="Footer">
    <ul>
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
  <p class="fineprint">
    This site sets no cookies, tracks no one and loads nothing from other servers. The screenshots show the real apps
    with sample data.
  </p>
</footer>
