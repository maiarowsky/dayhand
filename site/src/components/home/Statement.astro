---
// One sentence, set large, that says what Dayhand is for, with small marks for the plan, the screens and the yes.
import Icon from "../Icon.astro";
---

<section class="statement" aria-labelledby="statement-title">
  <h2 id="statement-title" class="visually-hidden">What Dayhand is</h2>
  <p>
    Write the day down <span class="keep">once <Icon name="sun" class="mark sun" /></span> and it is on your phone, your Mac
    and your <span class="keep">terminal <Icon name="phone" class="mark field" />.</span> Your agents pick up tasks from the same plan, and nothing risky happens
    until you say <span class="keep">yes <Icon name="check" class="mark ok" />.</span>
  </p>
</section>
