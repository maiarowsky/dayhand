---
// The first screen: what Dayhand is, the two ways in and the install command, then the real Mac app on a
// backdrop, and the ways an agent reaches the plan.
import Screenshot from "../Screenshot.astro";
import { DOCS_PATH } from "../../site";
import macLight from "../../assets/screens/mac-today-light.webp";
import macDark from "../../assets/screens/mac-today-dark.webp";

const reach = [
  { href: `${DOCS_PATH}mcp/`, label: "MCP" },
  { href: `${DOCS_PATH}cli/`, label: "the dayhand command" },
  { href: `${DOCS_PATH}api/`, label: "a REST API" },
  { href: `${DOCS_PATH}webhooks/`, label: "webhooks" },
  { href: `${DOCS_PATH}calendar/`, label: "a calendar feed" },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-text">
    <a class="pill" href="#screens">Android, macOS, Linux and your terminal. iPhone coming soon</a>
    <h1 id="hero-title">
      A day plan <img class="h1-mark" src="/favicon.svg" alt="" width="64" height="64" /> for you and your AI agents
    </h1>
    <p class="lead">
      Tasks, a calendar and reminders for people who run a business on their own. Your agents work on the same plan
      under rules you set, and ask you before a risky step.
    </p>
    <div class="actions">
      <a class="button primary" href="#get-dayhand">Get started</a>
      <a class="button" href={DOCS_PATH}>Read the docs</a>
    </div>
    <div class="quickstart inline-copy">
      <pre tabindex="0" class="code" data-copy data-copy-label="Copy the command that installs the command line and starts your own server"><code>npm i -g dayhand && dayhand server start</code></pre>
      <p class="fineprint">
        Free and open source. No account needed. <a href={`${DOCS_PATH}getting-started/`}>Quick start, about 10 minutes</a>
      </p>
    </div>
  </div>

  <figure class="stage backdrop">
    <div class="showcase">
      <Screenshot
        class="window"
        light={macLight}
        dark={macDark}
        widths={[700, 1080, 1600, 2160]}
        sizes="(min-width: 76rem) 66rem, calc(100vw - 3rem)"
        eager
        alt="Dayhand for macOS. On the left, Today: one overdue task, Send the October invoices; the task being worked on now, Write the proposal for the bakery website; and seven tasks for today. On the right, the details of Write the case study for the logo project: in progress, due today, labelled marketing, with two of three checklist items done."
      />
    </div>
    <figcaption class="stage-caption">The real Dayhand for macOS, on a sample plan.</figcaption>
  </figure>

  <div class="reach">
    <p>Agents reach the plan through</p>
    <ul role="list">
      {reach.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </div>
</section>
