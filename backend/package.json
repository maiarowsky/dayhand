{
  "name": "helm-backend",
  "version": "0.4.0",
  "private": true,
  "description": "Helm backend: Convex data model, domain operations, MCP endpoint and CLI",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "helm": "cli/helm.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "backend:fetch": "node scripts/fetch-local-backend.mjs",
    "backend:start": "node scripts/local-backend.mjs",
    "app-token": "node scripts/app-token.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p convex",
    "test": "vitest run"
  },
  "dependencies": {
    "convex": "1.46.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
