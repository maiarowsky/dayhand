{
  "name": "dayhand-backend",
  "version": "0.14.0",
  "private": true,
  "description": "Dayhand backend: Convex data model, domain operations, MCP endpoint, REST API and webhooks",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "backend:fetch": "node scripts/fetch-local-backend.mjs",
    "backend:start": "node scripts/local-backend.mjs",
    "setup": "node scripts/setup.mjs",
    "app-token": "node scripts/app-token.mjs",
    "schemas": "node scripts/gen-output-schemas.mjs",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p convex",
    "test": "vitest run"
  },
  "dependencies": {
    "convex": "1.46.0",
    "qrcode-terminal": "0.12.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ical.js": "2.2.1",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
