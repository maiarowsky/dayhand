# Copy to .env.local (ignored by git) and fill in. `npm run backend:start`
# writes the two Convex values for the local backend automatically.

# Convex CLI target for a self-hosted or local backend
CONVEX_SELF_HOSTED_URL=
CONVEX_SELF_HOSTED_ADMIN_KEY=

# Deployment environment (set with `npx convex env set`, never in a file here):
# DAYHAND_JWT_ISSUER, DAYHAND_JWKS, DAYHAND_JWT_PRIVATE_JWK. See docs/deploy.md.
