    <!-- Settings → Calendar: the read-only feed for Google and Apple Calendar. -->
    <string name="calendar_feed_title">Calendário</string>
    <string name="calendar_feed_off">Desativado</string>
    <string name="calendar_feed_on">Ativado</string>
    <string name="calendar_feed_intro">Mostre suas tarefas com data no Google Agenda ou no Calendário da Apple. O calendário é somente leitura: planeje no Dayhand e ele acompanha. Tarefas com horário viram eventos, as demais viram eventos de dia inteiro, as que se repetem levam sua regra e os lembretes viram alertas.</string>
    <string name="calendar_feed_turn_on">Ativar o endereço do calendário</string>
    <string name="calendar_feed_address">Endereço</string>
    <string name="calendar_feed_secret">Qualquer pessoa com este endereço pode ver suas tarefas com data. Compartilhe-o só com o seu próprio calendário; se ele vazar, crie um novo endereço.</string>
    <string name="calendar_feed_copy">Copiar endereço</string>
    <string name="calendar_feed_copied">Endereço copiado</string>
    <string name="calendar_feed_google">Adicionar ao Google Agenda</string>
    <string name="calendar_feed_google_note">Abre o Google Agenda na web (o app do celular não adiciona calendários por endereço). O Google atualiza os calendários assinados no próprio ritmo, geralmente a cada poucas horas, então as alterações aparecem lá com atraso.</string>
    <string name="calendar_feed_apple">Adicionar ao Calendário da Apple</string>
    <string name="calendar_feed_apple_note">Envia o endereço webcal para o seu iPhone ou Mac (Mensagens, Mail, AirDrop…); abra-o lá para assinar.</string>
    <string name="calendar_feed_manage">Gerenciar</string>
    <string name="calendar_feed_rotate">Criar um novo endereço</string>
    <string name="calendar_feed_rotate_confirm_title">Criar um novo endereço?</string>
    <string name="calendar_feed_rotate_confirm">O endereço atual para de funcionar na hora. Os calendários que o assinam deixam de ser atualizados até você adicionar o novo.</string>
    <string name="calendar_feed_rotate_done">Novo endereço criado; o antigo não funciona mais.</string>
    <string name="calendar_feed_turn_off">Desativar</string>
    <string name="calendar_feed_off_confirm_title">Desativar o endereço do calendário?</string>
    <string name="calendar_feed_off_confirm">O endereço para de funcionar e os calendários assinados deixam de ser atualizados. Você pode ativá-lo de novo com um novo endereço.</string>
