    <string name="calendar_feed_title">日历</string>
    <string name="calendar_feed_off">关闭</string>
    <string name="calendar_feed_on">开启</string>
    <string name="calendar_feed_intro">在 Google 日历或 Apple 日历中显示带日期的任务。日历是只读的：在 Dayhand 中规划，日历会随之更新。设有时间的任务显示为日程，其余显示为全天日程，重复任务带有重复规则，提醒显示为日程提醒。</string>
    <string name="calendar_feed_turn_on">开启日历地址</string>
    <string name="calendar_feed_address">地址</string>
    <string name="calendar_feed_secret">任何拿到这个地址的人都能看到你带日期的任务。只把它添加到你自己的日历；如果泄露了，请创建新地址。</string>
    <string name="calendar_feed_copy">复制地址</string>
    <string name="calendar_feed_copied">地址已复制</string>
    <string name="calendar_feed_google">添加到 Google 日历</string>
    <string name="calendar_feed_google_note">在网页上打开 Google 日历（手机应用无法通过地址添加日历）。Google 会按自己的节奏刷新订阅的日历，通常每隔几小时一次，因此更改会延迟显示。</string>
    <string name="calendar_feed_apple">添加到 Apple 日历</string>
    <string name="calendar_feed_apple_note">把 webcal 地址发送到你的 iPhone 或 Mac（信息、邮件、AirDrop…）；在那里打开即可订阅。</string>
