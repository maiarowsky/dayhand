    <!-- Settings → Calendar: the read-only feed for Google and Apple Calendar. -->
    <string name="calendar_feed_title">Calendario</string>
    <string name="calendar_feed_off">Desactivado</string>
    <string name="calendar_feed_on">Activado</string>
    <string name="calendar_feed_intro">Muestra tus tareas con fecha en Google Calendar o en Calendario de Apple. El calendario es de solo lectura: planifica en Dayhand y el calendario se actualiza solo. Las tareas con hora son eventos; las demás, eventos de todo el día; las que se repiten llevan su regla y los recordatorios aparecen como avisos.</string>
    <string name="calendar_feed_turn_on">Activar la dirección del calendario</string>
    <string name="calendar_feed_address">Dirección</string>
    <string name="calendar_feed_secret">Cualquiera que tenga esta dirección puede ver tus tareas con fecha. Compártela solo con tu propio calendario; si se filtra, crea una dirección nueva.</string>
    <string name="calendar_feed_copy">Copiar dirección</string>
    <string name="calendar_feed_copied">Dirección copiada</string>
    <string name="calendar_feed_google">Añadir a Google Calendar</string>
    <string name="calendar_feed_google_note">Abre Google Calendar en la web (la app del teléfono no puede añadir calendarios por dirección). Google actualiza los calendarios suscritos según su propio ritmo, normalmente cada pocas horas, así que los cambios tardan en aparecer allí.</string>
    <string name="calendar_feed_apple">Añadir a Calendario de Apple</string>
    <string name="calendar_feed_apple_note">Envía la dirección webcal a tu iPhone o Mac (Mensajes, Mail, AirDrop…); ábrela allí para suscribirte.</string>
    <string name="calendar_feed_manage">Gestionar</string>
    <string name="calendar_feed_rotate">Crear una dirección nueva</string>
    <string name="calendar_feed_rotate_confirm_title">¿Crear una dirección nueva?</string>
    <string name="calendar_feed_rotate_confirm">La dirección actual deja de funcionar de inmediato. Los calendarios suscritos a ella dejan de actualizarse hasta que añadas la nueva.</string>
    <string name="calendar_feed_rotate_done">Dirección nueva creada; la anterior ya no funciona.</string>
    <string name="calendar_feed_turn_off">Desactivar</string>
    <string name="calendar_feed_off_confirm_title">¿Desactivar la dirección del calendario?</string>
    <string name="calendar_feed_off_confirm">La dirección deja de funcionar y los calendarios suscritos dejan de actualizarse. Puedes volver a activarla con una dirección nueva.</string>
    <string name="calendar_feed_export_group">Archivo único</string>
    <string name="calendar_feed_export">Exportar archivo .ics</string>
    <string name="calendar_feed_export_note">Una copia del plan tal como está ahora, para importarla en cualquier calendario. No se actualiza.</string>
    <string name="calendar_feed_exporting">Preparando el archivo…</string>
