    <!-- Settings → Calendar: the read-only feed for Google and Apple Calendar. -->
    <string name="calendar_feed_title">Kalender</string>
    <string name="calendar_feed_off">Aus</string>
    <string name="calendar_feed_on">An</string>
    <string name="calendar_feed_intro">Zeige deine Aufgaben mit Datum in Google Kalender oder Apple Kalender. Der Kalender ist schreibgeschützt: Du planst in Dayhand, und er zieht nach. Aufgaben mit Uhrzeit werden zu Terminen, die übrigen zu ganztägigen Terminen, wiederkehrende mit ihrer Regel, Erinnerungen zu Hinweisen.</string>
    <string name="calendar_feed_turn_on">Kalenderadresse aktivieren</string>
    <string name="calendar_feed_address">Adresse</string>
    <string name="calendar_feed_secret">Jeder mit dieser Adresse kann deine Aufgaben mit Datum sehen. Teile sie nur mit deinem eigenen Kalender; falls sie in falsche Hände gerät, erstelle eine neue Adresse.</string>
    <string name="calendar_feed_copy">Adresse kopieren</string>
    <string name="calendar_feed_copied">Adresse kopiert</string>
    <string name="calendar_feed_google">Zu Google Kalender hinzufügen</string>
    <string name="calendar_feed_google_note">Öffnet Google Kalender im Web (die App auf dem Smartphone kann keine Kalender per Adresse hinzufügen). Google aktualisiert abonnierte Kalender nach eigenem Zeitplan, meist alle paar Stunden, daher erscheinen Änderungen dort verzögert.</string>
    <string name="calendar_feed_apple">Zu Apple Kalender hinzufügen</string>
    <string name="calendar_feed_apple_note">Sendet die webcal-Adresse an dein iPhone oder deinen Mac (Nachrichten, Mail, AirDrop…); öffne sie dort, um den Kalender zu abonnieren.</string>
    <string name="calendar_feed_manage">Verwalten</string>
    <string name="calendar_feed_rotate">Neue Adresse erstellen</string>
    <string name="calendar_feed_rotate_confirm_title">Neue Adresse erstellen?</string>
    <string name="calendar_feed_rotate_confirm">Die aktuelle Adresse funktioniert sofort nicht mehr. Kalender, die sie abonniert haben, werden erst wieder aktualisiert, wenn du die neue hinzufügst.</string>
    <string name="calendar_feed_rotate_done">Neue Adresse erstellt; die alte funktioniert nicht mehr.</string>
    <string name="calendar_feed_turn_off">Deaktivieren</string>
    <string name="calendar_feed_off_confirm_title">Kalenderadresse deaktivieren?</string>
    <string name="calendar_feed_off_confirm">Die Adresse funktioniert nicht mehr, und abonnierte Kalender werden nicht mehr aktualisiert. Du kannst sie mit einer neuen Adresse wieder aktivieren.</string>
    <string name="calendar_feed_export_group">Einmalige Datei</string>
    <string name="calendar_feed_export">.ics-Datei exportieren</string>
    <string name="calendar_feed_export_note">Eine Kopie des Plans im aktuellen Stand, zum Importieren in jeden Kalender. Sie wird nicht aktualisiert.</string>
