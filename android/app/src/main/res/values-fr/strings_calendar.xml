    <!-- Settings → Calendar: the read-only feed for Google and Apple Calendar. -->
    <string name="calendar_feed_title">Calendrier</string>
    <string name="calendar_feed_off">Désactivé</string>
    <string name="calendar_feed_on">Activé</string>
    <string name="calendar_feed_intro">Affichez vos tâches datées dans Google Agenda ou Calendrier Apple. Le calendrier est en lecture seule : planifiez dans Dayhand, il suit. Les tâches avec une heure deviennent des événements, les autres des événements sur toute la journée, les tâches répétées gardent leur règle, les rappels deviennent des alertes.</string>
    <string name="calendar_feed_turn_on">Activer l\'adresse du calendrier</string>
    <string name="calendar_feed_address">Adresse</string>
    <string name="calendar_feed_secret">Toute personne qui a cette adresse peut voir vos tâches datées. Ne la partagez qu\'avec votre propre calendrier ; en cas de fuite, créez une nouvelle adresse.</string>
    <string name="calendar_feed_copy">Copier l\'adresse</string>
    <string name="calendar_feed_copied">Adresse copiée</string>
    <string name="calendar_feed_google">Ajouter à Google Agenda</string>
    <string name="calendar_feed_google_note">Ouvre Google Agenda sur le Web (l\'app mobile ne peut pas ajouter un calendrier par son adresse). Google actualise les calendriers abonnés à son propre rythme, souvent toutes les quelques heures : les modifications y apparaissent donc avec du retard.</string>
    <string name="calendar_feed_apple">Ajouter au Calendrier Apple</string>
    <string name="calendar_feed_apple_note">Envoie l\'adresse webcal à votre iPhone ou Mac (Messages, Mail, AirDrop…) ; ouvrez-la là-bas pour vous abonner.</string>
    <string name="calendar_feed_manage">Gérer</string>
    <string name="calendar_feed_rotate">Créer une nouvelle adresse</string>
    <string name="calendar_feed_rotate_confirm_title">Créer une nouvelle adresse ?</string>
    <string name="calendar_feed_rotate_confirm">L\'adresse actuelle cesse immédiatement de fonctionner. Les calendriers abonnés ne se mettent plus à jour tant que vous n\'ajoutez pas la nouvelle.</string>
    <string name="calendar_feed_rotate_done">Nouvelle adresse créée ; l\'ancienne ne fonctionne plus.</string>
    <string name="calendar_feed_turn_off">Désactiver</string>
    <string name="calendar_feed_off_confirm_title">Désactiver l\'adresse du calendrier ?</string>
    <string name="calendar_feed_off_confirm">L\'adresse cesse de fonctionner et les calendriers abonnés ne se mettent plus à jour. Vous pourrez la réactiver avec une nouvelle adresse.</string>
    <string name="calendar_feed_export_group">Fichier ponctuel</string>
    <string name="calendar_feed_export">Exporter un fichier .ics</string>
    <string name="calendar_feed_export_note">Une copie du plan tel qu\'il est maintenant, à importer dans n\'importe quel calendrier. Elle ne se met pas à jour.</string>
