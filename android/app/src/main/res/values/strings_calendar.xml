    <!-- Settings → Calendar: the read-only feed for Google and Apple Calendar. -->
    <string name="calendar_feed_title">Calendar</string>
    <string name="calendar_feed_off">Off</string>
    <string name="calendar_feed_on">On</string>
    <string name="calendar_feed_intro">Show your dated tasks in Google Calendar or Apple Calendar. The calendar is read-only: plan in Helm, and it follows. Tasks with a time are events, the rest all-day events, repeating ones with their rule, reminders as alerts.</string>
    <string name="calendar_feed_turn_on">Turn on the calendar address</string>
    <string name="calendar_feed_address">Address</string>
    <string name="calendar_feed_secret">Anyone with this address can see your dated tasks. Share it only with your own calendar; if it leaks, create a new address.</string>
    <string name="calendar_feed_copy">Copy address</string>
    <string name="calendar_feed_copied">Address copied</string>
    <string name="calendar_feed_google">Add to Google Calendar</string>
    <string name="calendar_feed_google_note">Opens Google Calendar on the web (the phone app cannot add calendars by address). Google refreshes subscribed calendars on its own schedule, usually every few hours, so changes show up late there.</string>
    <string name="calendar_feed_apple">Add to Apple Calendar</string>
    <string name="calendar_feed_apple_note">Sends the webcal address to your iPhone or Mac (Messages, Mail, AirDrop…); open it there to subscribe.</string>
    <string name="calendar_feed_manage">Manage</string>
    <string name="calendar_feed_rotate">Create a new address</string>
    <string name="calendar_feed_rotate_confirm_title">Create a new address?</string>
    <string name="calendar_feed_rotate_confirm">The current address stops working at once. Calendars subscribed to it stop updating until you add the new one.</string>
    <string name="calendar_feed_rotate_done">New address created; the old one no longer works.</string>
    <string name="calendar_feed_turn_off">Turn off</string>
    <string name="calendar_feed_off_confirm_title">Turn off the calendar address?</string>
    <string name="calendar_feed_off_confirm">The address stops working and subscribed calendars stop updating. You can turn it on again with a new address.</string>
    <string name="calendar_feed_export_group">One-time file</string>
    <string name="calendar_feed_export">Export .ics file</string>
    <string name="calendar_feed_export_note">A copy of the plan as it is now, to import into any calendar. It does not update.</string>
    <string name="calendar_feed_exporting">Preparing the file…</string>
    <string name="calendar_feed_export_failed">Cannot export: the server cannot be reached.</string>
