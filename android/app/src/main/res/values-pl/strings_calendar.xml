    <!-- Ustawienia → Kalendarz: kanał tylko do odczytu dla Google i Apple. -->
    <string name="calendar_feed_title">Kalendarz</string>
    <string name="calendar_feed_off">Wyłączony</string>
    <string name="calendar_feed_on">Włączony</string>
    <string name="calendar_feed_intro">Pokaż zadania z datą w Kalendarzu Google lub Apple. Kalendarz jest tylko do odczytu: planujesz w Helmie, a on nadąża. Zadania z godziną są wydarzeniami, pozostałe całodniowymi, powtarzające się mają swoją regułę, a przypomnienia są alertami.</string>
    <string name="calendar_feed_turn_on">Włącz adres kalendarza</string>
    <string name="calendar_feed_address">Adres</string>
    <string name="calendar_feed_secret">Każdy, kto zna ten adres, widzi Twoje zadania z datą. Dodaj go tylko do własnego kalendarza; jeśli wycieknie, utwórz nowy adres.</string>
    <string name="calendar_feed_copy">Kopiuj adres</string>
    <string name="calendar_feed_copied">Skopiowano adres</string>
    <string name="calendar_feed_google">Dodaj do Kalendarza Google</string>
    <string name="calendar_feed_google_note">Otwiera Kalendarz Google w przeglądarce (aplikacja na telefon nie dodaje kalendarzy z adresu). Google odświeża subskrybowane kalendarze we własnym rytmie, zwykle co kilka godzin, więc zmiany pojawiają się tam z opóźnieniem.</string>
    <string name="calendar_feed_apple">Dodaj do Kalendarza Apple</string>
    <string name="calendar_feed_apple_note">Wysyła adres webcal na Twojego iPhone’a lub Maca (Wiadomości, Mail, AirDrop…); otwórz go tam, aby zasubskrybować.</string>
    <string name="calendar_feed_manage">Zarządzanie</string>
    <string name="calendar_feed_rotate">Utwórz nowy adres</string>
    <string name="calendar_feed_rotate_confirm_title">Utworzyć nowy adres?</string>
    <string name="calendar_feed_rotate_confirm">Obecny adres od razu przestanie działać. Kalendarze, które go subskrybują, przestaną się odświeżać, dopóki nie dodasz nowego.</string>
    <string name="calendar_feed_rotate_done">Utworzono nowy adres; stary już nie działa.</string>
    <string name="calendar_feed_turn_off">Wyłącz</string>
    <string name="calendar_feed_off_confirm_title">Wyłączyć adres kalendarza?</string>
    <string name="calendar_feed_off_confirm">Adres przestanie działać, a subskrybowane kalendarze przestaną się odświeżać. Możesz go włączyć ponownie z nowym adresem.</string>
    <string name="calendar_feed_export_group">Jednorazowy plik</string>
    <string name="calendar_feed_export">Eksportuj plik .ics</string>
    <string name="calendar_feed_export_note">Kopia planu w obecnym stanie do zaimportowania w dowolnym kalendarzu. Nie aktualizuje się.</string>
    <string name="calendar_feed_exporting">Przygotowuję plik…</string>
    <string name="calendar_feed_export_failed">Nie można wyeksportować: brak połączenia z serwerem.</string>
