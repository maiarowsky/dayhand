    <string name="calendar_feed_not_connected">Najpierw połącz się z serwerem: adres kalendarza udostępnia Twój serwer Helma.</string>
    <string name="calendar_feed_failed">Brak połączenia z serwerem. Spróbuj ponownie, gdy telefon będzie online.</string>
    <string name="calendar_feed_unauthorized">Serwer wylogował ten telefon. Połącz się ponownie w Ustawienia → Serwer.</string>
