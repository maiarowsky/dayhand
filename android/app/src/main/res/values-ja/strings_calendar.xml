    <string name="calendar_feed_title">カレンダー</string>
    <string name="calendar_feed_off">オフ</string>
    <string name="calendar_feed_on">オン</string>
    <string name="calendar_feed_intro">期日のあるタスクを Google カレンダーや Apple カレンダーに表示します。カレンダーは読み取り専用です。Dayhand で計画すれば、カレンダーが追従します。時刻のあるタスクは予定に、それ以外は終日の予定に、繰り返しタスクはそのルール付きで、リマインダーは通知になります。</string>
    <string name="calendar_feed_turn_on">カレンダーのアドレスをオンにする</string>
    <string name="calendar_feed_address">アドレス</string>
    <string name="calendar_feed_secret">このアドレスを知っている人は誰でも、期日のあるタスクを見られます。自分のカレンダーにだけ共有し、漏れた場合は新しいアドレスを作成してください。</string>
    <string name="calendar_feed_copy">アドレスをコピー</string>
    <string name="calendar_feed_copied">アドレスをコピーしました</string>
    <string name="calendar_feed_google">Google カレンダーに追加</string>
    <string name="calendar_feed_google_note">ウェブ版の Google カレンダーを開きます（スマートフォンアプリではアドレスからカレンダーを追加できません）。Google は登録済みのカレンダーを独自のスケジュール（通常は数時間ごと）で更新するため、変更の反映は遅れます。</string>
    <string name="calendar_feed_apple">Apple カレンダーに追加</string>
    <string name="calendar_feed_apple_note">webcal アドレスを iPhone または Mac に送ります（メッセージ、メール、AirDrop…）。そちらで開いて登録してください。</string>
    <string name="calendar_feed_manage">管理</string>
